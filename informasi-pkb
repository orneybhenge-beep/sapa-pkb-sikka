<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Informasi PKB | SAPA PKB SIKKa</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f8fb;
            color: #263238;
            line-height: 1.7;
        }

        /* =========================
           HEADER
        ========================= */

        header {
            background: #087fbd;
            color: white;
            padding: 16px 6%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 3px 15px rgba(0,0,0,0.15);
        }

        .logo {
            font-size: 20px;
            font-weight: bold;
            white-space: nowrap;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
        }

        .nav a {
            color: white;
            text-decoration: none;
            padding: 9px 12px;
            border-radius: 7px;
            font-size: 15px;
            transition: 0.3s;
            white-space: nowrap;
        }

        .nav a:hover,
        .nav a.active {
            background: rgba(255,255,255,0.18);
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            background:
                linear-gradient(
                    rgba(0, 55, 85, 0.82),
                    rgba(0, 55, 85, 0.82)
                );

            color: white;
            text-align: center;
            padding: 85px 20px;
        }

        .hero-icon {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .hero h1 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 750px;
            margin: auto;
            font-size: 18px;
        }


        /* =========================
           CONTAINER
        ========================= */

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 45px auto;
        }


        /* =========================
           CARD
        ========================= */

        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            border-left: 5px solid #087fbd;
        }

        .card-icon {
            font-size: 42px;
            margin-bottom: 8px;
        }

        .card h2 {
            color: #087fbd;
            margin-bottom: 12px;
            font-size: 25px;
        }

        .card p {
            margin-bottom: 12px;
        }

        .card ul {
            padding-left: 25px;
        }

        .card li {
            margin-bottom: 8px;
        }


        /* =========================
           INFO BOX
        ========================= */

        .info-box {
            background: #eef7fc;
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
        }

        .info-box strong {
            color: #087fbd;
        }


        /* =========================
           TOMBOL
        ========================= */

        .button-area {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .btn {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 9px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-primary {
            background: #087fbd;
            color: white;
        }

        .btn-primary:hover {
            background: #056795;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: #e7eef3;
            color: #263238;
        }

        .btn-secondary:hover {
            background: #d6e2e9;
            transform: translateY(-2px);
        }


        /* =========================
           NAVIGASI EDUKASI
        ========================= */

        .education-menu {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 35px;
        }

        .education-item {
            background: white;
            border-radius: 14px;
            padding: 22px;
            text-align: center;
            text-decoration: none;
            color: #263238;
            box-shadow: 0 4px 15px rgba(0,0,0,0.07);
            transition: 0.3s;
        }

        .education-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 22px rgba(0,0,0,0.12);
        }

        .education-item .icon {
            font-size: 38px;
            margin-bottom: 8px;
        }

        .education-item h3 {
            color: #087fbd;
            font-size: 18px;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #12344d;
            color: white;
            text-align: center;
            padding: 30px 20px;
            margin-top: 60px;
        }

        footer p {
            margin: 5px 0;
        }


        /* =========================
           RESPONSIVE HP
        ========================= */

        @media (max-width: 800px) {

            header {
                flex-direction: column;
                text-align: center;
            }

            .nav {
                justify-content: center;
            }

            .hero h1 {
                font-size: 30px;
            }

            .hero p {
                font-size: 16px;
            }

            .education-menu {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 22px;
            }
        }
    </style>
</head>


